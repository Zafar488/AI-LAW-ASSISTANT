# Groq API Key (Required for LLM generation & Whisper speech transcription)
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Internal API Key for securing FastAPI endpoints (/ask, /transcribe, /draft, /scan)
API_KEY=your_secret_api_key_here

# Groq LLM Model (openai/gpt-oss-120b, qwen/qwen3.8-27b, llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# FastAPI Backend Service URL
API_URL=http://127.0.0.1:8000

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
