{
    "schema_version":  2,
    "updated_at":  "2026-07-21",
    "policy":  "Official government, legislature, regulator and official gazette sources only. Bills, draft bills and proposed legislation are excluded unless they have become enforceable Acts, Ordinances, Rules, Regulations, Orders, Notifications or other final legal instruments.",
    "crawler_rules":  {
                          "allowed_domains_policy":  "Follow only the configured official source domain and its official subdomains. Do not follow external mirrors, private legal databases, news sites, blogs or document-sharing platforms.",
                          "allowed_document_types":  [
                                                         "act",
                                                         "ordinance",
                                                         "rule",
                                                         "regulation",
                                                         "order",
                                                         "notification",
                                                         "gazette",
                                                         "code",
                                                         "bylaw",
                                                         "rules_of_business",
                                                         "rules_of_procedure",
                                                         "constitutional_instrument",
                                                         "final_amendment",
                                                         "official_circular_with_legal_effect"
                                                     ],
                          "excluded_document_types":  [
                                                          "bill",
                                                          "draft_bill",
                                                          "government_bill",
                                                          "private_member_bill",
                                                          "proposed_legislation",
                                                          "consultation_draft",
                                                          "committee_report",
                                                          "press_release",
                                                          "news_item",
                                                          "speech",
                                                          "tender",
                                                          "job_notice"
                                                      ],
                          "exclude_url_patterns":  [
                                                       "/bill/",
                                                       "/bills/",
                                                       "bill.php",
                                                       "bills.php",
                                                       "/draft/",
                                                       "/drafts/",
                                                       "draft-bill",
                                                       "proposed-legislation",
                                                       "private-member-bill",
                                                       "government-bill"
                                                   ],
                          "exclude_title_patterns":  [
                                                         "\\bDraft Bill\\b",
                                                         "\\bGovernment Bill\\b",
                                                         "\\bPrivate Member\u0027?s Bill\\b",
                                                         "\\bProposed Bill\\b",
                                                         "\\bBill No\\.?\\s*\\d+\\b",
                                                         "\\bAs Introduced\\b",
                                                         "\\bUnder Consideration\\b",
                                                         "\\bCommittee Report\\b"
                                                     ],
                          "bill_exception_rule":  "A page or file containing the word \u0027bill\u0027 may be accepted only when the same official page clearly identifies the final instrument as an Act, gives an Act number or Gazette publication, and the fetched document itself is the enacted text.",
                          "prefer_final_consolidated_text":  true,
                          "prefer_gazette_over_secondary_copy":  true,
                          "follow_html_links":  true,
                          "follow_pdf_links":  true,
                          "follow_doc_and_docx_links":  true,
                          "extract_links_from_pdf":  true,
                          "respect_robots_txt":  true,
                          "rate_limit_requests_per_second":  0.5,
                          "request_timeout_seconds":  45,
                          "max_retries":  4,
                          "retry_backoff_seconds":  [
                                                        2,
                                                        5,
                                                        10,
                                                        20
                                                    ],
                          "deduplicate_by":  [
                                                 "normalized_title",
                                                 "jurisdiction",
                                                 "instrument_number",
                                                 "promulgation_or_publication_date",
                                                 "content_hash"
                                             ],
                          "minimum_metadata":  [
                                                   "source_name",
                                                   "source_url",
                                                   "document_url",
                                                   "jurisdiction",
                                                   "document_type",
                                                   "title",
                                                   "publication_or_promulgation_date",
                                                   "retrieved_at"
                                               ],
                          "recommended_metadata":  [
                                                       "act_or_instrument_number",
                                                       "gazette_number",
                                                       "department_or_regulator",
                                                       "amends",
                                                       "repeals",
                                                       "commencement_date",
                                                       "language",
                                                       "content_hash",
                                                       "superseded_status",
                                                       "consolidation_status"
                                                   ],
                          "acceptance_gate":  {
                                                  "require_official_domain":  true,
                                                  "require_final_legal_instrument":  true,
                                                  "reject_if_only_bill_or_draft":  true,
                                                  "reject_broken_or_empty_documents":  true,
                                                  "reject_login_or_captcha_pages_as_documents":  true,
                                                  "reject_duplicate_content_hash":  true
                                              }
                      },
